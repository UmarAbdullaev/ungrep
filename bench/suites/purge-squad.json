      "key": {
        "items": ["(?i)\\bframes?\\b", "\\b(PlayerLoop|EditorLoop|Idle|GC\\.\\w+|Canvas\\.\\w+|Gfx\\.\\w+|Mono\\.JIT|Camera\\.Render|BehaviourUpdate)\\W{1,4}\\d+\\.\\d\\d"],
