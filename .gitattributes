# LF everywhere so `dotnet format --verify-no-changes` agrees with .editorconfig on Windows
# checkouts (core.autocrlf would otherwise turn files into CRLF).
* text=auto eol=lf

# cmd.exe needs CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Vendored scripts stay byte for byte as published (SPEC-viewer, Boundaries).
src/Ungrep.Viewer/vendor/*.js -text
src/Ungrep.Viewer/vendor/*.LICENSE -text
