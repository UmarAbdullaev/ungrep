<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Needed for IDE0005 (unused usings) at build time. CS1591 is off: the style asks for a
         summary on every type, not on every member. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>

    <!-- Everything builds under artifacts/, so the repo-root bin/ stays free for the launchers. -->
    <UseArtifactsOutput>true</UseArtifactsOutput>

    <Version>0.9.0</Version>
    <!-- Keep the git hash out of the version so the version output is deterministic. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- build/package.sh sets UgPackage: the shipped build names paths from the repo root as /_/ (in the
       binaries and the Source Link map), so no machine's folder lands in them. Not for other builds:
       tests find goldens by source path. -->
  <PropertyGroup Condition="'$(UgPackage)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <Compile Include="$(MSBuildThisFileDirectory)tests\Shared\Golden.cs" Link="Golden.cs" />
    <Using Include="Xunit" />
    <Using Include="Ungrep.Tests" />
  </ItemGroup>
</Project>
