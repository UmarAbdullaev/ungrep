<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ug</AssemblyName>
    <RootNamespace>UnityGraph.Cli</RootNamespace>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UnityGraph.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnityGraph.Assets\UnityGraph.Assets.csproj" />
    <ProjectReference Include="..\UnityGraph.Bench\UnityGraph.Bench.csproj" />
    <ProjectReference Include="..\UnityGraph.Code\UnityGraph.Code.csproj" />
    <ProjectReference Include="..\UnityGraph.Core\UnityGraph.Core.csproj" />
    <ProjectReference Include="..\UnityGraph.EditorLink\UnityGraph.EditorLink.csproj" />
    <ProjectReference Include="..\UnityGraph.Stats\UnityGraph.Stats.csproj" />
    <ProjectReference Include="..\UnityGraph.Hooks\UnityGraph.Hooks.csproj" />
    <ProjectReference Include="..\UnityGraph.Query\UnityGraph.Query.csproj" />
    <ProjectReference Include="..\UnityGraph.Viewer\UnityGraph.Viewer.csproj" />
  </ItemGroup>

  <!-- SQLitePCLRaw ships e_sqlite3 for ~22 platforms; dist/ug keeps the desktop ones. -->
  <Target Name="KeepDesktopSqliteNatives" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_UgOtherNative Include="@(ResolvedFileToPublish)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '^runtimes[\\/](?!(win-x64|win-arm64|osx-x64|osx-arm64|linux-x64|linux-arm64)[\\/])'))" />
      <ResolvedFileToPublish Remove="@(_UgOtherNative)" />
    </ItemGroup>
  </Target>
</Project>
